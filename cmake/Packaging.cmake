include(InstallRequiredSystemLibraries)

set(CPACK_PACKAGE_NAME "Zyri")
set(CPACK_PACKAGE_VENDOR "Zyri")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Local-only graphics editor")

if(APPLE)
    set(CPACK_GENERATOR "DragNDrop")
    set(CPACK_DMG_VOLUME_NAME "Zyri")
    set(CPACK_BUNDLE_NAME "Zyri")
    set(CPACK_BUNDLE_PLIST "${CMAKE_SOURCE_DIR}/packaging/macos/Info.plist.in")
    set(CPACK_BUNDLE_ICON "${CMAKE_SOURCE_DIR}/packaging/macos/icon.icns")
elseif(WIN32)
    set(CPACK_GENERATOR "NSIS")
    set(CPACK_NSIS_DISPLAY_NAME "Zyri")
    set(CPACK_NSIS_PACKAGE_NAME "Zyri")
elseif(UNIX)
    set(CPACK_GENERATOR "External")
endif()

include(CPack)
