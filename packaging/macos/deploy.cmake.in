# Configured and generated by CMake; variables below resolve at install time.
set(bundle "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/Zyri.app")
file(WRITE "${bundle}/Contents/Resources/qt.conf" "[Paths]\nPlugins=PlugIns\n")
execute_process(COMMAND "@ZYRI_MACDEPLOYQT@" "${bundle}"
    -no-plugins -no-strip -appstore-compliant -always-overwrite -codesign=-
    "-libpath=@zyri_qt_library_dir@"
@zyri_plugin_options@
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 180)
if(NOT result EQUAL 0 OR "${output}${errors}" MATCHES "ERROR:")
    message(FATAL_ERROR "Qt deployment failed (${result}):\n${output}\n${errors}")
endif()
execute_process(COMMAND /usr/bin/codesign --verify --deep --strict "${bundle}"
    RESULT_VARIABLE signature_result OUTPUT_VARIABLE signature_output ERROR_VARIABLE signature_error)
if(NOT signature_result EQUAL 0)
    message(FATAL_ERROR "Ad-hoc bundle verification failed:\n${signature_output}\n${signature_error}")
endif()
message(STATUS "Deployed desktop Qt dependencies to ${bundle}")
