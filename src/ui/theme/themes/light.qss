/* ── Zyri Light Theme ────────────────────────────────────────────────────── */

QMainWindow, QWidget {
    background-color: #f0f0f0;
    color: #1a1a1a;
}

QMenuBar {
    background-color: #e8e8e8;
    color: #1a1a1a;
    border-bottom: 1px solid #ccc;
}

QMenuBar::item:selected { background-color: #d0d0d0; }

QMenu {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #ccc;
}

QMenu::item:selected { background-color: #0078d4; color: white; }

QToolBar {
    background-color: #e8e8e8;
    border: none;
    spacing: 2px;
    padding: 2px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px;
}

QToolButton:hover { background-color: #d8d8d8; border-color: #bbb; }
QToolButton:checked, QToolButton:pressed { background-color: #0078d4; border-color: #0060b0; }

QDockWidget::title {
    background-color: #e0e0e0;
    padding: 4px 8px;
    font-weight: 600;
    border-bottom: 1px solid #ccc;
}

QScrollBar:vertical { background: #e8e8e8; width: 10px; }
QScrollBar::handle:vertical { background: #bbb; border-radius: 4px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background: #999; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QSlider::groove:horizontal { height: 4px; background: #ccc; border-radius: 2px; }
QSlider::handle:horizontal { width: 14px; height: 14px; margin: -5px 0; background: #555; border-radius: 7px; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #fff;
    border: 1px solid #bbb;
    border-radius: 4px;
    padding: 3px 6px;
    color: #1a1a1a;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #0078d4; }

QPushButton {
    background-color: #e0e0e0;
    border: 1px solid #bbb;
    border-radius: 4px;
    padding: 5px 12px;
    color: #1a1a1a;
}
QPushButton:hover { background-color: #d0d0d0; }
QPushButton:pressed { background-color: #0078d4; color: white; }

QTabBar::tab { background: #e0e0e0; color: #666; padding: 6px 16px; border: none; border-right: 1px solid #ccc; }
QTabBar::tab:selected { background: #f0f0f0; color: #000; border-top: 2px solid #0078d4; }

QStatusBar { background-color: #e8e8e8; color: #666; border-top: 1px solid #ccc; }
